# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会提交到仓库。
# 已存在的同名环境变量优先级更高，不会被本文件覆盖。

# GitHub 个人访问令牌：把 GitHub API 限流从 60 次/小时提到 5000 次/小时。
# 只需「读取公开仓库」权限，可以不勾选任何 scope。
# 获取方式见 README「获取 GITHUB_TOKEN」一节。
GITHUB_TOKEN=

# 可选：Semantic Scholar API Key（论文互证）
S2_API_KEY=

# 可选：LLM 摘要服务（不填则自动降级为抽取式摘要）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 可选：邮件推送（本机直接跑 --push email 时需要）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# 可选：即时通讯 webhook（钉钉 / 飞书 / Slack）
IM_WEBHOOK=
